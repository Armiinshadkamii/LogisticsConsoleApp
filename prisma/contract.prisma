// use prisma-8

enum UserRole {
  MANAGER
  DRIVER
  NORMAL
}

model User {
  id           String   @id @default(cuid(2))
  firstName    String
  lastName     String
  phone        String   @unique
  address      String

  role         UserRole @default(NORMAL)
}

model OTP {
  id        String   @id @default(cuid(2))
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}